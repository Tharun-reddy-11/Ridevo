# Copy this file to .env for Docker Compose. Never commit real production credentials.
MYSQL_DATABASE=ridenexa
MYSQL_USER=ridenexa_app
MYSQL_PASSWORD=change_this_local_password
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_PORT=3306

BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# Reserved for later phases; leave unset until an adapter is configured.
JWT_SECRET=replace-with-a-long-random-secret-before-phase-2
ADMIN_EMAIL=platform-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAP_PROVIDER=
MAP_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
VOICE_PROVIDER=
VOICE_API_KEY=
AI_PROVIDER=
AI_API_KEY=
